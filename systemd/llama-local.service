[Unit]
Description=llama.cpp local model for llmrouter
After=network-online.target
# Descarrega o modelo quando o gateway do cliente para. Os dois nomes sao
# aceitos: a unit que nao existir no host e ignorada pelo systemd.
PartOf=openclaw-gateway.service hermes-gateway.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=@REPO@/run-local.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
KillMode=mixed

[Install]
WantedBy=default.target
