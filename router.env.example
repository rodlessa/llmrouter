# llmrouter - configuracao. Copie para router.env e preencha.
#   cp router.env.example router.env && chmod 600 router.env

# ---- API (qualquer endpoint OpenAI-compatible) -----------------------------
API_BASE_URL=https://api.deepseek.com
API_KEY=sua-chave-aqui
API_MODEL=deepseek-v4-flash

# ---- modelo local (llama.cpp) ----------------------------------------------
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=local
# Precisa ser igual ao -c do llama-server (local.env: CTX)
LOCAL_CTX=32768

# "*" = o modelo local pode receber o conjunto completo de tools.
# Lista separada por virgula = so essas tools vao para o local.
LOCAL_TOOL_ALLOWLIST=*

# ---- ciclo de vida do llama-server -----------------------------------------
# O router sobe o servico sob demanda e derruba depois de N segundos ocioso.
LOCAL_SERVICE=llama-local.service
LOCAL_AUTOSTART=1
LOCAL_IDLE_STOP_SECONDS=180
# Nao sobe o modelo se a VRAM livre estiver abaixo disso (deixa o jogo em paz)
LOCAL_MIN_FREE_VRAM_MIB=13500

# ---- rodape de rota no fim das respostas -----------------------------------
FOOTER=1
# 1 = so em requests com tools (nao polui chamadas internas do cliente)
FOOTER_REQUIRE_TOOLS=1

# ---- Laya (decisor local opcional, Apache-2.0) -----------------------------
# off | advise | decide
LAYA_MODE=advise
LAYA_DECIDE_P=0.75
# LAYA_LOG=/caminho/para/decisions.jsonl

# ---- debug -----------------------------------------------------------------
ROUTER_DEBUG=1
