# llama-server - configuracao do modelo local.
#   cp local.env.example local.env

# Caminho do binario do llama.cpp nesta maquina
LLAMA_SERVER=/home/SEU_USUARIO/ai/llama.cpp/build/bin/llama-server

# Caminho do .gguf
MODEL_PATH=/home/SEU_USUARIO/models/gpt-oss-20b-UD-Q4_K_XL.gguf
MODEL_NAME=gpt-oss-20b-Q4XL

# Janela de contexto (tem que bater com LOCAL_CTX do router.env)
CTX=32768
PORT=8080

# Threads de CPU para as camadas que nao couberem na GPU
THREADS=16
